@if (Visible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-footer">
                    @if (ConfirmPending)
                    {
                        <span class="me-auto text-warning fw-semibold">Save these changes?</span>
                        <button class="btn btn-success" @onclick="OnConfirm">Yes, Save</button>
                        <button class="btn btn-secondary" @onclick="CancelConfirm">Go Back</button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="RequestConfirm">Save</button>
                        <button class="btn btn-secondary" @onclick="Close">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool ConfirmPending { get; set; }

    private void RequestConfirm() => ConfirmPending = true;
    private void CancelConfirm() => ConfirmPending = false;

    private async Task Close()
    {
        ConfirmPending = false;
        await OnClose.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        if (!Visible) ConfirmPending = false;
    }
}
