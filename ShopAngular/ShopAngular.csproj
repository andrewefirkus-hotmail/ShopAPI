<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Put binary in bin\launcher\ so the Angular root is always exactly two
         levels up from AppContext.BaseDirectory at runtime. -->
    <OutputPath>bin\launcher\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent VS from scanning heavy Angular directories -->
    <Compile Remove="node_modules\**;dist\**;src\**;public\**" />
    <Content Remove="node_modules\**;dist\**;src\**;public\**" />
    <None    Remove="node_modules\**;dist\**;src\**;public\**" />
    <EmbeddedResource Remove="node_modules\**;dist\**;src\**;public\**" />
  </ItemGroup>
</Project>
